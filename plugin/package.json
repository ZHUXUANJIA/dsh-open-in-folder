{
    "name":  "dsh-open-in-folder",
    "version":  "0.2.0",
    "description":  "Windows Explorer 右键打开文件夹：把任意文件夹作为 DeepSeek Harness 工作区打开（ZCode 风格右键菜单）",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "windows",
                     "explorer",
                     "context-menu",
                     "workspace"
                 ],
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-api-workspace-controller",
                                              "@deepseek-ai/dsh-client-ui-workspace"
                                          ]
                           }
            },
    "license":  "MIT"
}
